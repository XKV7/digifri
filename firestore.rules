//
// Firestore security rules for the optional cloud save feature (see
// src/cloud-save.ts) and in-game gifting (see src/gift.ts). Paste this into
// Firebase Console > Firestore Database > Rules, then Publish.
//
// Each signed-in user can only read/write their own save documents under
// users/{their uid}/saves/*. Nobody else can read or write another user's
// data, and unauthenticated access is denied entirely. Gifting adds two
// more collections, giftProfiles/* and gifts/*, scoped as documented below.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/saves/{saveKey} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // In-game gifting (see src/gift.ts). Each signed-in client publishes its
    // own email -> uid mapping here so a sender can address a gift to a
    // friend's email without needing their Firebase UID. Only the profile
    // owner may write it; any signed-in user may read it (email + uid only).
    match /giftProfiles/{uid} {
      allow get, list: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Gift inbox: any signed-in user can drop a gift (a voucher or a
    // Pokemon species) into another user's inbox; only the recipient can
    // read or remove their own gifts. The recipient's client applies and
    // deletes each gift the next time they open the in-game menu.
    match /gifts/{targetUid}/inbox/{giftId} {
      allow read, delete: if request.auth != null && request.auth.uid == targetUid;
      allow create: if request.auth != null
                    && request.auth.uid != targetUid
                    && request.resource.data.keys().hasOnly(['kind', 'voucherType', 'count', 'speciesId', 'dexSnapshot', 'starterSnapshot', 'fromEmail', 'createdAt'])
                    && request.resource.data.kind in ['voucher', 'pokemon']
                    && request.resource.data.createdAt is number;
      allow update: if false;
    }

    // PvP invite inbox (see src/pvp-invite.ts): any signed-in user can drop an invite (pointing
    // at a room they created just for this target - see pvpRooms' invitedUid) into another
    // user's inbox; only the recipient can read or remove their own invites. Checked
    // opportunistically on title screen load and when the player list panel opens, same
    // "opportunistic claim" pattern as the gift inbox above.
    match /pvpInvites/{targetUid}/inbox/{inviteId} {
      allow read, delete: if request.auth != null && request.auth.uid == targetUid;
      allow create: if request.auth != null
                    && request.auth.uid != targetUid
                    && request.resource.data.fromUid == request.auth.uid
                    && request.resource.data.fromName is string
                    && request.resource.data.roomId is string
                    && request.resource.data.keys().hasOnly(['fromUid', 'fromName', 'roomId', 'createdAt'])
                    && request.resource.data.createdAt is number;
      allow update: if false;
    }

    // PvP: each account's standing 6-Pokemon PvP roster (see src/pvp-team.ts).
    // Only the owner may write it; any signed-in user may read it, since
    // building the opponent's side of a PvP battle requires reading their
    // registered team.
    match /pvpTeams/{uid} {
      allow get: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // PvP lobby rooms (see src/pvp-room.ts). Any signed-in user may list/read
    // rooms (to show the open-room lobby and watch a joined room live). A room
    // is created by its host (status must start "waiting"); after that, the
    // host may update it freely (cancel it, submit team-preview picks, mark it
    // finished), a different signed-in user may join it once by claiming the
    // still-empty guest slot while it's still "waiting" (moving it to
    // "team_preview"), and once they're the guest they may likewise update it
    // freely (submit their own picks, mark it finished). Not locked down
    // further than "must already be host/guest of this room" — per the
    // project's own stated threat model, cheating by directly editing PvP data
    // isn't a concern here.
    match /pvpRooms/{roomId} {
      allow get, list: if request.auth != null;

      allow create: if request.auth != null
                    && request.resource.data.hostUid == request.auth.uid
                    && request.resource.data.hostName is string
                    && request.resource.data.status == 'waiting'
                    && request.resource.data.keys().hasOnly(['hostUid', 'hostName', 'status', 'createdAt', 'invitedUid'])
                    && (!('invitedUid' in request.resource.data) || request.resource.data.invitedUid is string)
                    && request.resource.data.createdAt is timestamp;

      allow update: if request.auth != null
                    && (
                      resource.data.hostUid == request.auth.uid
                      || resource.data.guestUid == request.auth.uid
                      || (
                        resource.data.status == 'waiting'
                        && resource.data.hostUid != request.auth.uid
                        && (!('invitedUid' in resource.data) || resource.data.invitedUid == request.auth.uid)
                        && request.resource.data.hostUid == resource.data.hostUid
                        && request.resource.data.hostName == resource.data.hostName
                        && request.resource.data.guestUid == request.auth.uid
                        && request.resource.data.guestName is string
                        && request.resource.data.status == 'team_preview'
                      )
                    );

      allow delete: if false;
    }

    // Global leaderboard (see src/leaderboard.ts): one document per account holding that
    // account's best-known value for each tracked stat (Classic fastest clear time, Endless max
    // wave, PvP wins). Any signed-in user may read the whole collection (to render top-N lists);
    // only the owner may write their own document, and only in the "improving" direction per
    // stat (lower for time, higher for wave/wins) relative to whatever's already stored - this
    // stops accidental regressions, not outright fabrication of a first value, which (as with
    // the rest of this project's data) isn't treated as a concern here.
    //
    // `resource` is null for a brand-new document (every account's very first submission), so
    // each monotonic check below short-circuits on `resource == null` before ever touching
    // `resource.data` - reading .data off a null resource is a rules evaluation error, which
    // denies the whole write. Without that guard, every account's first-ever leaderboard write
    // would be silently rejected forever.
    //
    // classicBestTimeSeconds is month-scoped (see leaderboard.ts's submitClassicMonthlyRecord and
    // getMonthKey): classicMonthKey records which month a stored classicBestTimeSeconds belongs
    // to, and the "must improve" check below is skipped (any value accepted) whenever the
    // incoming write's month differs from what's already stored - that's the actual reset. A
    // pre-existing doc from before this field existed has no classicMonthKey, which the check
    // below also treats as "different month" so the first post-feature write isn't stuck
    // comparing against a monthless legacy value.
    match /leaderboardStats/{uid} {
      allow get, list: if request.auth != null;

      allow write: if request.auth != null
                  && request.auth.uid == uid
                  && request.resource.data.displayName is string
                  && request.resource.data.keys().hasOnly(['displayName', 'classicBestTimeSeconds', 'classicMonthKey', 'endlessMaxWave', 'pvpWins'])
                  && (
                    !('classicMonthKey' in request.resource.data)
                    || request.resource.data.classicMonthKey is string
                  )
                  && (
                    !('classicBestTimeSeconds' in request.resource.data)
                    || resource == null
                    || !('classicBestTimeSeconds' in resource.data)
                    || !('classicMonthKey' in resource.data)
                    || request.resource.data.classicMonthKey != resource.data.classicMonthKey
                    || request.resource.data.classicBestTimeSeconds <= resource.data.classicBestTimeSeconds
                  )
                  && (
                    !('endlessMaxWave' in request.resource.data)
                    || resource == null
                    || !('endlessMaxWave' in resource.data)
                    || request.resource.data.endlessMaxWave >= resource.data.endlessMaxWave
                  )
                  && (
                    !('pvpWins' in request.resource.data)
                    || resource == null
                    || !('pvpWins' in resource.data)
                    || request.resource.data.pvpWins >= resource.data.pvpWins
                  );
    }

    // Online presence (see src/presence.ts): one doc per signed-in account holding just a
    // server-stamped lastSeen timestamp, refreshed on a heartbeat while the game is open. The
    // title screen's "players online" count is a server-side aggregation over "lastSeen within
    // the last ~90s", so any signed-in user may read (get/list) the collection; only the owner
    // may write their own doc, and lastSeen must be the request's own server timestamp (a client
    // can't backdate/forwarddate its own presence, though - as with the rest of this project's
    // data - it could simply keep heartbeating to stay "online" indefinitely, which isn't treated
    // as a concern here).
    //
    // Also carries displayName and inRun (whether that account currently has a run in progress),
    // written on the same heartbeat - this is what friend-list-panel.ts reads to render the
    // title screen's player list and gate PvP invites away from accounts mid-run.
    match /presence/{uid} {
      allow get, list: if request.auth != null;

      allow write: if request.auth != null
                  && request.auth.uid == uid
                  && request.resource.data.keys().hasOnly(['lastSeen', 'displayName', 'inRun'])
                  && request.resource.data.lastSeen == request.time
                  && request.resource.data.displayName is string
                  && request.resource.data.inRun is bool;
    }

    // Daily login reward (see src/daily-reward.ts): one doc per signed-in account tracking the
    // last calendar date (local to that client, "YYYY-MM-DD") its reward was claimed on. Only
    // the owner may read/write it, and the date may only move forward - a client can't rewrite it
    // to an earlier date to re-claim the same day's reward repeatedly.
    match /dailyRewards/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;

      allow write: if request.auth != null
                  && request.auth.uid == uid
                  && request.resource.data.keys().hasOnly(['lastClaimedDate'])
                  && request.resource.data.lastClaimedDate is string
                  && (
                    resource == null
                    || !('lastClaimedDate' in resource.data)
                    || request.resource.data.lastClaimedDate > resource.data.lastClaimedDate
                  );
    }
  }
}
