//
// Firestore security rules for the optional cloud save feature (see
// src/cloud-save.ts) and in-game gifting (see src/gift.ts). Paste this into
// Firebase Console > Firestore Database > Rules, then Publish.
//
// Each signed-in user can only read/write their own save documents under
// users/{their uid}/saves/*. Nobody else can read or write another user's
// data, and unauthenticated access is denied entirely. Gifting adds two
// more collections, giftProfiles/* and gifts/*, scoped as documented below.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/saves/{saveKey} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // In-game gifting (see src/gift.ts). Each signed-in client publishes its
    // own email -> uid mapping here so a sender can address a gift to a
    // friend's email without needing their Firebase UID. Only the profile
    // owner may write it; any signed-in user may read it (email + uid only).
    match /giftProfiles/{uid} {
      allow get, list: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Gift inbox: any signed-in user can drop a gift (a voucher or a
    // Pokemon species) into another user's inbox; only the recipient can
    // read or remove their own gifts. The recipient's client applies and
    // deletes each gift the next time they open the in-game menu.
    match /gifts/{targetUid}/inbox/{giftId} {
      allow read, delete: if request.auth != null && request.auth.uid == targetUid;
      allow create: if request.auth != null
                    && request.auth.uid != targetUid
                    && request.resource.data.keys().hasOnly(['kind', 'voucherType', 'count', 'speciesId', 'dexSnapshot', 'starterSnapshot', 'fromEmail', 'createdAt'])
                    && request.resource.data.kind in ['voucher', 'pokemon']
                    && request.resource.data.createdAt is number;
      allow update: if false;
    }

    // PvP: each account's standing 6-Pokemon PvP roster (see src/pvp-team.ts).
    // Only the owner may write it; any signed-in user may read it, since
    // building the opponent's side of a PvP battle requires reading their
    // registered team.
    match /pvpTeams/{uid} {
      allow get: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // PvP lobby rooms (see src/pvp-room.ts). Any signed-in user may list/read
    // rooms (to show the open-room lobby and watch a joined room live). A room
    // is created by its host (status must start "waiting"); after that, the
    // host may update it freely (cancel it, submit team-preview picks, mark it
    // finished), a different signed-in user may join it once by claiming the
    // still-empty guest slot while it's still "waiting" (moving it to
    // "team_preview"), and once they're the guest they may likewise update it
    // freely (submit their own picks, mark it finished). Not locked down
    // further than "must already be host/guest of this room" — per the
    // project's own stated threat model, cheating by directly editing PvP data
    // isn't a concern here.
    match /pvpRooms/{roomId} {
      allow get, list: if request.auth != null;

      allow create: if request.auth != null
                    && request.resource.data.hostUid == request.auth.uid
                    && request.resource.data.hostName is string
                    && request.resource.data.status == 'waiting'
                    && request.resource.data.keys().hasOnly(['hostUid', 'hostName', 'status', 'createdAt'])
                    && request.resource.data.createdAt is timestamp;

      allow update: if request.auth != null
                    && (
                      resource.data.hostUid == request.auth.uid
                      || resource.data.guestUid == request.auth.uid
                      || (
                        resource.data.status == 'waiting'
                        && resource.data.hostUid != request.auth.uid
                        && request.resource.data.hostUid == resource.data.hostUid
                        && request.resource.data.hostName == resource.data.hostName
                        && request.resource.data.guestUid == request.auth.uid
                        && request.resource.data.guestName is string
                        && request.resource.data.status == 'team_preview'
                      )
                    );

      allow delete: if false;
    }
  }
}
